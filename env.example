# Database
DATABASE_URL="postgresql://username:password@localhost:5432/contazoom?schema=public"

# JWT Authentication
JWT_SECRET="your-jwt-secret-key-here"

# API URL (opcional)
# Se vazio, usa localhost:3000
# Se for usar backend separado no Render:
# NEXT_PUBLIC_API_URL="https://project-backend-rjoh.onrender.com"
NEXT_PUBLIC_API_URL=""

# Mercado Livre API
MELI_CLIENT_ID="your-meli-client-id"
MELI_CLIENT_SECRET="your-meli-client-secret"
MELI_REDIRECT_URI="http://localhost:3000/api/meli/callback"

# Shopee API
SHOPEE_CLIENT_ID="your-shopee-client-id"
SHOPEE_CLIENT_SECRET="your-shopee-client-secret"
SHOPEE_REDIRECT_URI="http://localhost:3000/api/shopee/callback"

# TikTok Shop Partner API
# As três são OBRIGATÓRIAS: sem elas /api/tiktok/auth responde 500 dizendo o que
# falta, em vez de abrir uma autorização que não funcionaria.
# Saem do Partner Center (partner.tiktokshop.com), em "App Information".
TIKTOK_APP_KEY="your-tiktok-app-key"
TIKTOK_APP_SECRET="your-tiktok-app-secret"
TIKTOK_SERVICE_ID="your-tiktok-service-id"

# Origem pública permitida adicional para o OAuth do TikTok (opcional).
# A autorização guarda no banco a origem real em que começou. Se a callback fixa
# do Partner Center voltar entre contazoom.com.br e app.contazoom.com.br, o
# servidor a retransmite ao host original antes de conferir cookie e sessão.
# Em outro domínio de homologação, informe aqui a origem HTTPS exata.
TIKTOK_REDIRECT_ORIGIN=""

# --- Ajuste fino do TikTok Shop (todas opcionais, com padrão no código) -------
#
# Taxas do BR. Vêm do env para poder corrigir sem deploy: o TikTok já mudou a
# taxa por item de R$ 4,00 para R$ 6,00 uma vez. Ao mudar, suba também a
# TIKTOK_FINANCIAL_RULE_VERSION em src/lib/tiktok-finance.ts — é ela que faz o
# sync recalcular as linhas antigas a partir do payload guardado, sem chamar API.
# TIKTOK_SFP_FEE_RATE="0.06"          # Programa de Frete: 6% do subtotal
# TIKTOK_PER_ITEM_FEE="6"             # R$ por UNIDADE (line_item = 1 unidade)
#
# Janela do sync. O primeiro sync de uma loja varre TIKTOK_LOOKBACK_DAYS e pode
# passar do timeout do proxy — o job continua no servidor, acompanhe pelo SSE.
# TIKTOK_LOOKBACK_DAYS="120"
# TIKTOK_OVERLAP_MINUTES="15"         # Recuo do watermark de update_time
#
# Passo de liquidação (o financeiro real, que só existe ~7 dias após a entrega).
# TIKTOK_SETTLEMENT_BATCH="300"       # Pedidos conferidos por execução
# TIKTOK_SETTLEMENT_RETRY_HOURS="12"  # Espera antes de reconsultar o mesmo pedido
# TIKTOK_REPROCESS_BATCH="1000"       # Linhas recalculadas por mudança de regra

# Bling API
BLING_CLIENT_ID="your-bling-client-id"
BLING_CLIENT_SECRET="your-bling-client-secret"
BLING_REDIRECT_URI="http://localhost:3000/api/bling/callback"

# Cron Jobs
CRON_SECRET="your-cron-secret-key"

# --- Notificações por e-mail (Brevo) ------------------------------------------
#
# Quando a equipe envia um documento para o cliente, o aviso aparece no sino do
# painel na hora e o e-mail sai pela API do Brevo, agrupado: documentos enviados
# em sequência vão juntos num e-mail só.
# Sem BREVO_API_KEY ou BREVO_SENDER_EMAIL o e-mail fica desligado (o log avisa
# uma vez) e o sino continua funcionando.
#
# Chave em app.brevo.com > SMTP & API > API Keys.
BREVO_API_KEY=""
# Remetente VALIDADO no Brevo (Senders, Domains & Dedicated IPs). Remetente não
# validado faz o Brevo recusar o envio.
BREVO_SENDER_EMAIL="avisos@contazoom.com.br"
# BREVO_SENDER_NAME="ContaZoom"
# Para onde vai a resposta do cliente (opcional).
# BREVO_REPLY_TO="contato@contazoom.com.br"
# "1" = o Brevo valida o pedido e NÃO entrega (teste em produção sem e-mail real).
# BREVO_SANDBOX="0"
#
# Endereço público do painel, base dos links e do logotipo do e-mail.
# Padrão em produção: https://app.contazoom.com.br
# APP_URL="https://app.contazoom.com.br"
#
# Silêncio, em segundos, depois do último documento para o e-mail sair
# (padrão 90). O e-mail nunca espera mais de 10 minutos.
# NOTIFICACOES_EMAIL_ESPERA_SEGUNDOS="90"
