generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(uuid())
  name                String
  email               String               @unique @db.Citext
  passwordHash        String               @map("password_hash")
  country             String?              @db.VarChar(2)
  role                String               @default("USER")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  blingAccounts       BlingAccount[]
  blingOauthStates    BlingOauthState[]
  categorias          Categoria[]
  contasPagar         ContaPagar[]
  contasReceber       ContaReceber[]
  formasPagamento     FormaPagamento[]
  meliAccounts        MeliAccount[]
  meliOauthStates     MeliOauthState[]
  meliVendas          MeliVenda[]
  shopeeAccounts      ShopeeAccount[]
  shopeeOauthStates   ShopeeOauthState[]
  shopeeVendas        ShopeeVenda[]
  skus                SKU[]
  skuCustoHistorico   SKUCustoHistorico[]
  notifications       SyncNotification[]
  settings            UserSettings?
  aliquotasImposto    AliquotaImposto[]
  documents           Document[]
  documentFolders     DocumentFolder[]
  documentLogs        DocumentLog[]
  flexShippingConfigs FlexShippingConfig[]

  // --- Módulo de tarefas contábeis -----------------------------------------
  // Relações inversas apenas: não criam coluna nem alteram a tabela `usuario`.
  empresas             Empresa[]
  empresasResponsavel  Empresa[]             @relation("EmpresaResponsavel")
  apuracoesResponsavel TarefaApuracao[]      @relation("ApuracaoResponsavel")
  processosResponsavel ProcessoLegalizacao[] @relation("ProcessoResponsavel")
  tarefaLogs           TarefaLog[]           @relation("TarefaLogAutor")

  @@index([createdAt])
  @@map("usuario")
}

model MeliAccount {
  id                          String      @id @default(cuid())
  userId                      String
  ml_user_id                  BigInt
  nickname                    String?
  access_token                String
  refresh_token               String
  expires_at                  DateTime
  refresh_token_invalid_until DateTime?
  created_at                  DateTime    @default(now())
  updated_at                  DateTime    @updatedAt
  user                        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  meliVendas                  MeliVenda[]

  @@unique([userId, ml_user_id], name: "userId_ml_user_id")
  @@map("meli_account")
}

model MeliOauthState {
  id         String   @id @default(cuid())
  state      String   @unique
  expires_at DateTime
  created_at DateTime @default(now())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expires_at])
  @@map("meli_oauth_state")
}

model ShopeeAccount {
  id                          String        @id @default(cuid())
  userId                      String        @map("user_id")
  shop_id                     String
  shop_name                   String?       @map("shop_name")
  merchant_id                 String?
  access_token                String
  refresh_token               String
  expires_at                  DateTime
  refresh_token_invalid_until DateTime?
  created_at                  DateTime      @default(now())
  updated_at                  DateTime      @updatedAt
  user                        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  shopeeVendas                ShopeeVenda[]

  @@unique([userId, shop_id], name: "userId_shop_id")
  @@map("shopee_account")
}

model ShopeeOauthState {
  id         String   @id @default(cuid())
  state      String   @unique
  userId     String   @map("user_id")
  expires_at DateTime
  created_at DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expires_at])
  @@map("shopee_oauth_state")
}

model BlingAccount {
  id                          String    @id @default(cuid())
  userId                      String    @map("user_id")
  bling_user_id               String?   @map("bling_user_id")
  account_name                String?   @map("account_name")
  access_token                String
  refresh_token               String
  expires_at                  DateTime
  refresh_token_invalid_until DateTime?
  created_at                  DateTime  @default(now())
  updated_at                  DateTime  @updatedAt
  user                        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, bling_user_id], name: "userId_bling_user_id")
  @@map("bling_account")
}

model BlingOauthState {
  id         String   @id @default(cuid())
  state      String   @unique
  userId     String   @map("user_id")
  expires_at DateTime
  created_at DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expires_at])
  @@map("bling_oauth_state")
}

model MeliVenda {
  id                 String      @id @default(cuid())
  orderId            String      @unique @map("order_id")
  userId             String      @map("user_id")
  meliAccountId      String      @map("meli_account_id")
  dataVenda          DateTime    @map("data_venda")
  status             String
  conta              String
  valorTotal         Decimal     @map("valor_total") @db.Decimal(10, 2)
  quantidade         Int
  unitario           Decimal     @map("valor_unitario") @db.Decimal(10, 2)
  taxaPlataforma     Decimal?    @map("taxa_plataforma") @db.Decimal(10, 2)
  frete              Decimal     @map("valor_frete") @db.Decimal(10, 2)
  cmv                Decimal?    @map("cmv") @db.Decimal(10, 2)
  margemContribuicao Decimal?    @map("margem_contribuicao") @db.Decimal(10, 2)
  isMargemReal       Boolean     @default(false) @map("is_margem_real")
  titulo             String
  sku                String?
  comprador          String
  logisticType       String?     @map("logistic_type")
  envioMode          String?     @map("envio_mode")
  shippingStatus     String?     @map("shipping_status")
  shippingId         String?     @map("shipping_id")
  exposicao          String?
  tipoAnuncio        String?     @map("tipo_anuncio")
  ads                String?
  plataforma         String      @default("Mercado Livre")
  canal              String      @default("ML")
  tags               Json?
  internalTags       Json?       @map("internal_tags")
  rawData            Json?       @map("raw_data")
  sincronizadoEm     DateTime    @default(now()) @map("sincronizado_em")
  atualizadoEm       DateTime    @updatedAt @map("atualizado_em")
  latitude           Decimal?    @db.Decimal(10, 7)
  longitude          Decimal?    @db.Decimal(10, 7)
  freteAdjustment    Decimal?    @map("frete_adjustment") @db.Decimal(10, 2)
  freteAjuste        Decimal?    @map("frete_ajuste") @db.Decimal(12, 2)
  freteBaseCost      Decimal?    @map("frete_base_cost") @db.Decimal(10, 2)
  freteCalculation   Json?       @map("frete_calculation")
  freteFinalCost     Decimal?    @map("frete_final_cost") @db.Decimal(10, 2)
  freteListCost      Decimal?    @map("frete_list_cost") @db.Decimal(10, 2)
  meliAccount        MeliAccount @relation(fields: [meliAccountId], references: [id], onDelete: Cascade)
  user               User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([meliAccountId])
  @@index([dataVenda])
  @@index([orderId])
  @@index([userId, dataVenda(sort: Desc)]) // Índice composto para queries principais
  @@index([sku]) // Índice para busca por SKU
  @@index([status]) // Índice para filtros de status
  @@map("meli_venda")
}

model ShopeeVenda {
  id                 String        @id @default(cuid())
  orderId            String        @unique @map("order_id")
  userId             String        @map("user_id")
  shopeeAccountId    String        @map("shopee_account_id")
  dataVenda          DateTime      @map("data_venda")
  status             String
  conta              String
  valorTotal         Decimal       @map("valor_total") @db.Decimal(10, 2)
  quantidade         Int
  unitario           Decimal       @map("valor_unitario") @db.Decimal(10, 2)
  taxaPlataforma     Decimal?      @map("taxa_plataforma") @db.Decimal(10, 2)
  frete              Decimal       @map("valor_frete") @db.Decimal(10, 2)
  freteAjuste        Decimal?      @map("frete_ajuste") @db.Decimal(12, 2)
  cmv                Decimal?      @map("cmv") @db.Decimal(10, 2)
  margemContribuicao Decimal?      @map("margem_contribuicao") @db.Decimal(10, 2)
  isMargemReal       Boolean       @default(false) @map("is_margem_real")
  titulo             String
  sku                String?
  comprador          String
  logisticType       String?       @map("logistic_type")
  envioMode          String?       @map("envio_mode")
  shippingStatus     String?       @map("shipping_status")
  shippingId         String?       @map("shipping_id")
  paymentMethod      String?       @map("payment_method")
  paymentStatus      String?       @map("payment_status")
  latitude           Decimal?      @db.Decimal(10, 7)
  longitude          Decimal?      @db.Decimal(10, 7)
  freteBaseCost      Decimal?      @map("frete_base_cost") @db.Decimal(10, 2)
  freteListCost      Decimal?      @map("frete_list_cost") @db.Decimal(10, 2)
  freteFinalCost     Decimal?      @map("frete_final_cost") @db.Decimal(10, 2)
  freteAdjustment    Decimal?      @map("frete_adjustment") @db.Decimal(10, 2)
  freteCalculation   Json?         @map("frete_calculation")
  shipmentDetails    Json?         @map("shipment_details")
  paymentDetails     Json?         @map("payment_details")
  plataforma         String        @default("Shopee")
  canal              String        @default("SP")
  tags               Json?
  internalTags       Json?         @map("internal_tags")
  rawData            Json?         @map("raw_data")
  sincronizadoEm     DateTime      @default(now()) @map("sincronizado_em")
  atualizadoEm       DateTime      @updatedAt @map("atualizado_em")
  shopeeAccount      ShopeeAccount @relation(fields: [shopeeAccountId], references: [id], onDelete: Cascade)
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([shopeeAccountId])
  @@index([dataVenda])
  @@index([orderId])
  @@index([userId, dataVenda(sort: Desc)]) // Índice composto para queries principais
  @@index([sku]) // Índice para busca por SKU
  @@index([status]) // Índice para filtros de status
  @@map("shopee_venda")
}

model UserSettings {
  id              String    @id @default(cuid())
  userId          String    @unique @map("user_id")
  autoSyncEnabled Boolean   @default(false) @map("auto_sync_enabled")
  lastAutoSyncAt  DateTime? @map("last_auto_sync_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model SyncNotification {
  id             String    @id @default(cuid())
  userId         String    @map("user_id")
  type           String    @default("new_orders")
  title          String
  message        String
  newOrdersCount Int       @default(0) @map("new_orders_count")
  isRead         Boolean   @default(false) @map("is_read")
  readAt         DateTime? @map("read_at")
  metadata       Json?
  createdAt      DateTime  @default(now()) @map("created_at")
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("sync_notification")
}

model SKU {
  id             String              @id @default(cuid())
  userId         String              @map("user_id")
  sku            String
  produto        String
  tipo           String              @default("filho")
  skuPai         String?             @map("sku_pai")
  custoUnitario  Decimal             @map("custo_unitario") @db.Decimal(10, 2)
  quantidade     Int                 @default(0)
  proporcao      Decimal?            @map("proporcao") @db.Decimal(5, 4)
  hierarquia1    String?             @map("hierarquia_1")
  hierarquia2    String?             @map("hierarquia_2")
  ativo          Boolean             @default(true)
  temEstoque     Boolean             @default(true) @map("tem_estoque")
  skusFilhos     Json?               @map("skus_filhos")
  observacoes    String?
  imagemUrl      String?             @map("imagem_url")
  tags           Json?
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  custoHistorico SKUCustoHistorico[]

  @@unique([userId, sku])
  @@index([userId])
  @@index([sku])
  @@index([tipo])
  @@index([ativo])
  @@index([temEstoque])
  @@map("sku")
}

model SKUCustoHistorico {
  id            String   @id @default(cuid())
  skuId         String   @map("sku_id")
  userId        String   @map("user_id")
  custoAnterior Decimal? @map("custo_anterior") @db.Decimal(10, 2)
  custoNovo     Decimal  @map("custo_novo") @db.Decimal(10, 2)
  quantidade    Int      @default(0)
  motivo        String?
  tipoAlteracao String   @map("tipo_alteracao")
  alteradoPor   String?  @map("alterado_por")
  createdAt     DateTime @default(now()) @map("created_at")
  sku           SKU      @relation(fields: [skuId], references: [id], onDelete: Cascade)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([skuId])
  @@index([userId])
  @@index([createdAt])
  @@map("sku_custo_historico")
}

model FormaPagamento {
  id             String         @id @default(cuid())
  userId         String         @map("user_id")
  blingId        String?        @map("bling_id")
  nome           String
  descricao      String?
  tipo           String?
  ativo          Boolean        @default(true)
  sincronizadoEm DateTime       @default(now()) @map("sincronizado_em")
  atualizadoEm   DateTime       @updatedAt @map("atualizado_em")
  contasPagar    ContaPagar[]
  contasReceber  ContaReceber[]
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, blingId])
  @@index([userId])
  @@index([blingId])
  @@map("forma_pagamento")
}

model Categoria {
  id             String         @id @default(cuid())
  userId         String         @map("user_id")
  blingId        String?        @map("bling_id")
  nome           String
  descricao      String?
  tipo           String?
  ativo          Boolean        @default(true)
  categoriaPaiId String?        @map("categoria_pai_id")
  sincronizadoEm DateTime       @default(now()) @map("sincronizado_em")
  atualizadoEm   DateTime       @updatedAt @map("atualizado_em")
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoriaPai   Categoria?     @relation("SubCategorias", fields: [categoriaPaiId], references: [id], onDelete: SetNull)
  subCategorias  Categoria[]    @relation("SubCategorias")
  contasPagar    ContaPagar[]
  contasReceber  ContaReceber[]

  @@unique([userId, blingId], name: "userId_blingId")
  @@index([userId])
  @@index([blingId])
  @@index([categoriaPaiId])
  @@map("categoria")
}

model ContaPagar {
  id               String          @id @default(cuid())
  userId           String          @map("user_id")
  blingId          String?         @map("bling_id")
  formaPagamentoId String?         @map("forma_pagamento_id")
  categoriaId      String?         @map("categoria_id")
  descricao        String
  historico        String?
  valor            Decimal         @db.Decimal(10, 2)
  dataVencimento   DateTime        @map("data_vencimento")
  dataPagamento    DateTime?       @map("data_pagamento")
  dataCompetencia  DateTime?       @map("data_competencia")
  status           String          @default("pendente")
  origem           String          @default("MANUAL") // MANUAL, SINCRONIZACAO, EXCEL
  sincronizadoEm   DateTime        @default(now()) @map("sincronizado_em")
  atualizadoEm     DateTime        @updatedAt @map("atualizado_em")
  categoria        Categoria?      @relation(fields: [categoriaId], references: [id])
  formaPagamento   FormaPagamento? @relation(fields: [formaPagamentoId], references: [id])
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, blingId])
  @@index([userId])
  @@index([blingId])
  @@index([dataVencimento])
  @@index([origem])
  @@map("conta_pagar")
}

model ContaReceber {
  id               String          @id @default(cuid())
  userId           String          @map("user_id")
  blingId          String?         @map("bling_id")
  formaPagamentoId String?         @map("forma_pagamento_id")
  categoriaId      String?         @map("categoria_id")
  descricao        String
  valor            Decimal         @db.Decimal(10, 2)
  dataVencimento   DateTime        @map("data_vencimento")
  dataRecebimento  DateTime?       @map("data_recebimento")
  status           String          @default("pendente")
  origem           String          @default("MANUAL") // MANUAL, SINCRONIZACAO, EXCEL
  sincronizadoEm   DateTime        @default(now()) @map("sincronizado_em")
  atualizadoEm     DateTime        @updatedAt @map("atualizado_em")
  categoria        Categoria?      @relation(fields: [categoriaId], references: [id])
  formaPagamento   FormaPagamento? @relation(fields: [formaPagamentoId], references: [id])
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, blingId])
  @@index([userId])
  @@index([blingId])
  @@index([dataVencimento])
  @@index([origem])
  @@map("conta_receber")
}

model AliquotaImposto {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  conta      String // Conta/CNPJ (ex: "Mercado Livre - Moscou", "Shopee Principal")
  accountId  String?  @map("account_id")
  plataforma String?
  aliquota   Decimal  @db.Decimal(5, 2) // Percentual (ex: 5.00 para 5%)
  dataInicio DateTime @map("data_inicio")
  dataFim    DateTime @map("data_fim")
  descricao  String? // Descrição adicional (ex: "Simples Nacional", "Lucro Presumido")
  ativo      Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([conta])
  @@index([userId, plataforma, accountId])
  @@index([dataInicio, dataFim])
  @@index([ativo])
  @@map("aliquota_imposto")
}

model Document {
  id           String @id @default(cuid())
  userId       String @map("user_id")
  fileName     String @map("file_name")
  fileUrl      String @map("file_url")
  originalName String @map("original_name")
  mimeType     String @map("mime_type")
  sizeBytes    Int    @map("size_bytes")

  // Categorization
  category  String // "INSTITUCIONAL", "IMPOSTOS", "FATURAMENTO", "FOLHA"
  subFolder String? @map("sub_folder") // e.g. "2026/01_Janeiro"
  folderId  String? @map("folder_id")

  folder DocumentFolder? @relation(fields: [folderId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs DocumentLog[]

  @@index([userId])
  @@index([category])
  @@index([subFolder])
  @@index([folderId])
  @@map("documento")
}

model DocumentFolder {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  name      String
  icon      String?
  parentId  String?  @map("parent_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents    Document[]
  parentFolder DocumentFolder?  @relation("SubFolders", fields: [parentId], references: [id], onDelete: Cascade)
  subFolders   DocumentFolder[] @relation("SubFolders")

  @@index([userId])
  @@index([parentId])
  @@map("document_folder")
}

model DocumentLog {
  id         String   @id @default(cuid())
  documentId String   @map("document_id")
  action     String // "VIEWED", "DOWNLOADED"
  userId     String   @map("user_id") // Quem realizou a ação
  createdAt  DateTime @default(now()) @map("created_at")

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([userId])
  @@map("document_log")
}

model FlexShippingConfig {
  id                  String   @id @default(cuid())
  userId              String   @map("user_id")
  custoPorPacote      Decimal  @map("custo_por_pacote") @db.Decimal(10, 2)
  unidadesPorCobranca Int      @default(1) @map("unidades_por_cobranca")
  descricao           String?
  ativo               Boolean  @default(true)
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("flex_shipping_config")
}

// ============================================================================
// MÓDULO DE TAREFAS CONTÁBEIS
//
// Especificação completa em NOVIDADES/MODULO_TAREFAS_CONTABEIS.md
//
// Tudo aqui é ADITIVO: nenhuma tabela existente é alterada. O model User só
// ganhou relações inversas, que são virtuais no Prisma e não geram coluna.
//
// Padrões seguidos do resto do schema: cuid() como id, @@map em snake_case,
// created_at/updated_at, onDelete: Cascade nos filhos, e status/tipo como
// String com os valores válidos listados em comentário (o schema não usa enum
// em nenhum lugar; as constantes vivem em src/lib/tarefa-etapas.ts).
// ============================================================================

/// A empresa (CNPJ) atendida. É a unidade de trabalho da contabilidade.
///
/// Separada do User de propósito: User é login, Empresa é quem sofre a
/// apuração. Um login pode responder por vários CNPJs, e a ContaZoom pode
/// atender um CNPJ que ainda não tem login (comum em cliente em abertura).
model Empresa {
  id String @id @default(cuid())

  /// CNPJ só com dígitos, sem máscara.
  ///
  /// OPCIONAL desde a mudança de 30/08/2026: empresa em abertura não tem CNPJ, e
  /// a regra nova é que todo processo de legalização nasce atrelado a uma empresa
  /// já cadastrada — inclusive a abertura. Sem isto, abertura seria o único
  /// processo solto no sistema.
  ///
  /// Segue `@unique`: no Postgres, índice único aceita vários NULL, então quantas
  /// empresas em abertura existirem convivem sem conflito, e no instante em que o
  /// CNPJ sai a unicidade volta a valer.
  cnpj String? @unique @db.VarChar(14)

  razaoSocial     String    @map("razao_social")
  nomeFantasia    String?   @map("nome_fantasia")
  regime          String // SIMPLES_NACIONAL, LUCRO_PRESUMIDO
  uf              String?   @db.VarChar(2)
  municipio       String?
  inicioAtividade DateTime? @map("inicio_atividade")

  /// Grupo econômico / grupo do cliente. Várias empresas do mesmo dono.
  ///
  /// Texto livre e não tabela própria: o escritório pediu "NOME DO GRUPO" como
  /// campo de cadastro, e uma tabela de grupos exigiria manter cadastro de grupo
  /// antes de cadastrar empresa — passo a mais para um dado que hoje só serve
  /// para agrupar visualmente.
  grupo String?

  inscricaoMunicipal String? @map("inscricao_municipal")
  inscricaoEstadual  String? @map("inscricao_estadual")

  /// Endereço completo, em partes.
  ///
  /// Separado em colunas, e não um campo "endereço" só: CEP e UF são o que se
  /// filtra e o que a Junta e a Prefeitura exigem por campo. Endereço num blob de
  /// texto não dá para conferir nem para reaproveitar em documento.
  cep         String? @db.VarChar(8) // só dígitos
  logradouro  String?
  numero      String? @db.VarChar(20)
  complemento String?
  bairro      String?

  /// Nome de quem responde pela empresa no dia a dia, do lado do cliente.
  ///
  /// Não é FK: é o contato operacional do cliente (quem manda as notas, quem
  /// atende o telefone), que não tem login no sistema. `responsavelId` continua
  /// sendo o responsável INTERNO, do escritório — são duas pessoas diferentes e
  /// juntá-las num campo só perderia uma das duas.
  responsavelOperacional String? @map("responsavel_operacional")

  socioAdmNome String? @map("socio_adm_nome")
  /// CPF do sócio administrador, só dígitos. Sem `@unique`: a mesma pessoa pode
  /// ser sócia administradora de várias empresas, o que é o caso comum em grupo.
  socioAdmCpf  String? @map("socio_adm_cpf") @db.VarChar(11)

  /// Plano interno ContaZoom. É o status OPERACIONAL da empresa.
  /// PLANO_SIMPLES, PLANO_PRESUMIDO, PLANO_STANDBY, SEM_PLANO_SUSPENSA
  ///
  /// Substituiu `situacao` na tela de empresas (filtro, indicadores e selo) e é
  /// quem decide a abertura mensal de competência: Simples e Presumido geram,
  /// Standby e sem plano não.
  ///
  /// Coluna PRÓPRIA, e não reaproveitando `regime`: `fluxoApuracao` lança exceção
  /// em regime desconhecido, então gravar "PLANO_STANDBY" em `regime` derrubaria
  /// a tela de toda competência da empresa.
  planoInterno String @default("PLANO_SIMPLES") @map("plano_interno")

  /// Situação no atendimento, não na Receita.
  /// ATIVA, SUSPENSA, ENCERRADA, EM_ABERTURA
  ///
  /// DERIVADA do plano interno e da existência do CNPJ (`situacaoDoPlano` em
  /// src/lib/tarefa-etapas.ts), não mais digitada no cadastro. Continua no banco
  /// porque ENCERRADA guarda algo que plano nenhum carrega — a empresa deixou de
  /// existir, não só de ser cliente — e porque três rotas e a tela de detalhe
  /// dependem dela. Só um PATCH explícito a sobrescreve.
  situacao String @default("ATIVA")

  /// Qual imposto municipal/estadual se aplica, usado para nomear a etapa 6 do
  /// Lucro Presumido: comércio apura ICMS, serviço apura ISS, nunca os dois.
  /// ICMS, ISS, AMBOS, NENHUM
  tributoLocal String @default("AMBOS") @map("tributo_local")

  /// Login do cliente, quando existir. SetNull e não Cascade: apagar o login
  /// nunca pode apagar o histórico fiscal da empresa.
  userId String? @map("user_id")
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  responsavelId String? @map("responsavel_id")
  responsavel   User?   @relation("EmpresaResponsavel", fields: [responsavelId], references: [id], onDelete: SetNull)

  observacoes String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  apuracoes       TarefaApuracao[]
  processos       ProcessoLegalizacao[]
  regimeHistorico EmpresaRegimeHistorico[]

  @@index([userId])
  @@index([regime])
  @@index([situacao])
  @@index([planoInterno])
  @@index([razaoSocial])
  @@index([grupo])
  @@map("empresa")
}

/// Linha do tempo do regime tributário da empresa.
///
/// Existe porque desenquadramento existe. Sem isto, mudar o regime reescreveria
/// o passado: a apuração de março (Simples) passaria a ser lida como Lucro
/// Presumido só porque a empresa mudou em julho.
model EmpresaRegimeHistorico {
  id             String    @id @default(cuid())
  empresaId      String    @map("empresa_id")
  regime         String
  vigenciaInicio DateTime  @map("vigencia_inicio")
  vigenciaFim    DateTime? @map("vigencia_fim") // null = vigente
  motivo         String?
  registradoPor  String?   @map("registrado_por")
  createdAt      DateTime  @default(now()) @map("created_at")

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@index([empresaId])
  @@index([vigenciaInicio])
  @@map("empresa_regime_historico")
}

/// Uma competência (mês/ano) de uma empresa.
///
/// `ano` e `mes` como Int em vez de DateTime ou string "2026/01_Janeiro":
/// ordena e filtra sem parsing, a unicidade composta é natural e não sofre com
/// fuso horário — que é o defeito de DateTime para competência.
model TarefaApuracao {
  id        String @id @default(cuid())
  empresaId String @map("empresa_id")
  ano       Int
  mes       Int // 1 a 12

  /// Regime CONGELADO na criação da tarefa. Ver EmpresaRegimeHistorico.
  regime String

  /// Posição no fluxo. 0 = não iniciada. Máximo depende do regime (10 ou 14).
  etapaAtual Int @default(0) @map("etapa_atual")

  /// Resumo macro DERIVADO da etapa. Gravado para permitir filtro e agregação
  /// no banco; recalculado sempre na mesma transação da mudança de etapa.
  /// AGUARDANDO_DOCUMENTACAO, EM_ELABORACAO, EM_REVISAO, ENTREGUE,
  /// PENDENCIA_IDENTIFICADA, CONCLUIDO
  status String @default("AGUARDANDO_DOCUMENTACAO")

  /// Bloqueio ativo. Sai do fluxo normal: a tarefa pode estar na etapa 4 e
  /// bloqueada ao mesmo tempo, e o status macro passa a refletir o bloqueio.
  bloqueada           Boolean   @default(false)
  bloqueioMotivo      String?   @map("bloqueio_motivo")
  bloqueioDesde       DateTime? @map("bloqueio_desde")
  /// CLIENTE, ESCRITORIO, COMERCIAL_CZ, TERCEIRO
  bloqueioResponsavel String?   @map("bloqueio_responsavel")

  prazoEntrega DateTime? @map("prazo_entrega")
  iniciadaEm   DateTime? @map("iniciada_em")
  concluidaEm  DateTime? @map("concluida_em")

  responsavelId String? @map("responsavel_id")
  responsavel   User?   @relation("ApuracaoResponsavel", fields: [responsavelId], references: [id], onDelete: SetNull)

  observacoes String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  empresa Empresa               @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  etapas  TarefaApuracaoEtapa[]
  logs    TarefaLog[]
  anexos  TarefaAnexo[]

  /// Uma apuração por empresa por competência. É a trava que impede duplicata
  /// quando dois operadores abrem o mês ao mesmo tempo.
  @@unique([empresaId, ano, mes], name: "empresa_competencia")
  @@index([status])
  @@index([ano, mes])
  @@index([bloqueada])
  @@index([prazoEntrega])
  @@index([responsavelId])
  @@map("tarefa_apuracao")
}

/// Uma linha por etapa do fluxo, criada junto com a tarefa.
///
/// Materializar as etapas (em vez de só guardar etapaAtual) é o que permite
/// saber quando cada etapa foi concluída e por quem, marcar etapa opcional como
/// não aplicável sem furar a numeração, e medir onde o processo trava.
model TarefaApuracaoEtapa {
  id              String  @id @default(cuid())
  tarefaId        String  @map("tarefa_id")
  numero          Int // 1..10 (SN) ou 1..14 (LP)
  chave           String
  titulo          String // congelado na criação
  /// COMERCIAL_CZ, ESCRITORIO, AMBOS
  responsavelTipo String  @map("responsavel_tipo")
  opcional        Boolean @default(false)

  /// PENDENTE, EM_ANDAMENTO, CONCLUIDA, NAO_APLICAVEL
  situacao String @default("PENDENTE")

  iniciadaEm   DateTime? @map("iniciada_em")
  concluidaEm  DateTime? @map("concluida_em")
  concluidaPor String?   @map("concluida_por")
  observacao   String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tarefa TarefaApuracao @relation(fields: [tarefaId], references: [id], onDelete: Cascade)

  @@unique([tarefaId, numero])
  @@index([tarefaId])
  @@index([situacao])
  @@map("tarefa_apuracao_etapa")
}

/// Processo pontual de legalização, com começo e fim.
///
/// Separado da apuração porque o ciclo de vida é outro: não tem competência,
/// não nasce sozinho todo mês, pode haver vários em paralelo e depende de prazo
/// de órgão externo.
model ProcessoLegalizacao {
  id        String  @id @default(cuid())
  empresaId String? @map("empresa_id") // opcional: abertura ainda não tem empresa

  /// Identificação provisória para o processo existir antes do CNPJ.
  identificacaoProvisoria String? @map("identificacao_provisoria")

  /// ABERTURA_CNPJ, ENCERRAMENTO_CNPJ, REGULARIZACAO_CNPJ,
  /// ALTERACAO_CADASTRAL, DESENQUADRAMENTO
  tipo String

  etapaAtual Int    @default(0) @map("etapa_atual")
  status     String @default("AGUARDANDO_DOCUMENTACAO")

  bloqueada           Boolean   @default(false)
  bloqueioMotivo      String?   @map("bloqueio_motivo")
  bloqueioDesde       DateTime? @map("bloqueio_desde")
  bloqueioResponsavel String?   @map("bloqueio_responsavel")

  /// Protocolo no órgão de terceiro. É o primeiro dado que o cliente pergunta.
  protocoloExterno String? @map("protocolo_externo")
  /// JUNTA_COMERCIAL, RECEITA_FEDERAL, PREFEITURA, SEFAZ, CERTIFICADORA
  orgaoExterno     String? @map("orgao_externo")

  prazoEstimado DateTime? @map("prazo_estimado")
  abertoEm      DateTime  @default(now()) @map("aberto_em")
  concluidoEm   DateTime? @map("concluido_em")

  responsavelId String? @map("responsavel_id")
  responsavel   User?   @relation("ProcessoResponsavel", fields: [responsavelId], references: [id], onDelete: SetNull)

  observacoes String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  empresa Empresa?                   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  etapas  ProcessoLegalizacaoEtapa[]
  logs    TarefaLog[]
  anexos  TarefaAnexo[]

  @@index([empresaId])
  @@index([tipo])
  @@index([status])
  @@index([bloqueada])
  @@index([abertoEm])
  @@map("processo_legalizacao")
}

model ProcessoLegalizacaoEtapa {
  id              String    @id @default(cuid())
  processoId      String    @map("processo_id")
  numero          Int
  chave           String
  titulo          String
  responsavelTipo String    @map("responsavel_tipo")
  opcional        Boolean   @default(false)
  situacao        String    @default("PENDENTE")
  iniciadaEm      DateTime? @map("iniciada_em")
  concluidaEm     DateTime? @map("concluida_em")
  concluidaPor    String?   @map("concluida_por")
  observacao      String?
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  processo ProcessoLegalizacao @relation(fields: [processoId], references: [id], onDelete: Cascade)

  @@unique([processoId, numero])
  @@index([processoId])
  @@map("processo_legalizacao_etapa")
}

/// O "quem mudou o quê e quando".
///
/// Uma tabela para os dois tipos de tarefa, com FKs opcionais: a tela de
/// auditoria é uma só, e unir duas tabelas em toda consulta seria pior.
///
/// APPEND-ONLY. A aplicação nunca faz UPDATE nem DELETE aqui, nem para admin:
/// log editável não é prova de nada.
model TarefaLog {
  id String @id @default(cuid())

  apuracaoId String? @map("apuracao_id")
  processoId String? @map("processo_id")

  /// TAREFA_CRIADA, ETAPA_CONCLUIDA, ETAPA_AVANCADA, ETAPA_RETORNADA,
  /// ETAPA_NAO_APLICAVEL, STATUS_ALTERADO, BLOQUEIO_REGISTRADO,
  /// BLOQUEIO_RESOLVIDO, RESPONSAVEL_ALTERADO, PRAZO_ALTERADO,
  /// OBSERVACAO_ADICIONADA, TAREFA_CONCLUIDA, TAREFA_REABERTA,
  /// PROTOCOLO_ATUALIZADO, EMPRESA_VINCULADA
  acao String

  de      String? // valor anterior, legível
  para    String? // valor novo, legível
  detalhe String? // motivo, observação

  autorId    String  @map("autor_id")
  /// Congelado: nome de funcionário muda e sai da empresa, log não muda.
  autorNome  String  @map("autor_nome")
  autorPapel String? @map("autor_papel")

  createdAt DateTime @default(now()) @map("created_at")

  apuracao TarefaApuracao?      @relation(fields: [apuracaoId], references: [id], onDelete: Cascade)
  processo ProcessoLegalizacao? @relation(fields: [processoId], references: [id], onDelete: Cascade)
  /// Restrict: excluir usuário não pode apagar o histórico do que ele fez.
  autor    User                 @relation("TarefaLogAutor", fields: [autorId], references: [id], onDelete: Restrict)

  @@index([apuracaoId, createdAt])
  @@index([processoId, createdAt])
  @@index([autorId])
  @@index([createdAt])
  @@index([acao])
  @@map("tarefa_log")
}

/// Documento ou imagem anexado a uma competência ou a um processo.
///
/// MODEL PRÓPRIO, e não `processoId` acrescentado a `Document`.
///
/// `Document` é o cofre de documentos do CLIENTE: `userId` é obrigatório, o
/// arquivo aparece na árvore de pastas do painel dele, e o upload é restrito a
/// administrador. Anexo de tarefa é o oposto em todas essas três dimensões — é
/// interno, pertence à tarefa e não a um login, e quem anexa é quem trabalha no
/// fluxo. Pendurar um `processoId` opcional em `Document` faria todo anexo de
/// tarefa precisar de um usuário dono arbitrário e aparecer na pasta do cliente.
///
/// Uma tabela para os dois tipos de tarefa, com FKs opcionais, seguindo
/// `TarefaLog`: a tela de anexos é uma só e unir duas tabelas em cada consulta
/// seria pior. A regra "exatamente uma das duas FKs preenchida" é garantida por
/// CHECK no banco, não só na aplicação.
model TarefaAnexo {
  id String @id @default(cuid())

  apuracaoId String? @map("apuracao_id")
  processoId String? @map("processo_id")

  /// Nome que o arquivo tinha na máquina de quem enviou. É o que a tela mostra.
  nomeOriginal String @map("nome_original")
  /// Nome no disco: timestamp + aleatório + nome higienizado. Nunca o original,
  /// senão dois envios de "contrato.pdf" sobrescreveriam um ao outro.
  arquivo      String @unique
  tipoMime     String @map("tipo_mime")
  tamanhoBytes Int    @map("tamanho_bytes")

  /// Congelados como em TarefaLog: quem enviou continua respondido depois de o
  /// funcionário sair da empresa.
  enviadoPorId   String  @map("enviado_por_id")
  enviadoPorNome String  @map("enviado_por_nome")

  /// Descrição opcional ("contrato social assinado", "guia paga").
  descricao String?

  createdAt DateTime @default(now()) @map("created_at")

  apuracao TarefaApuracao?      @relation(fields: [apuracaoId], references: [id], onDelete: Cascade)
  processo ProcessoLegalizacao? @relation(fields: [processoId], references: [id], onDelete: Cascade)

  @@index([apuracaoId, createdAt])
  @@index([processoId, createdAt])
  @@index([enviadoPorId])
  @@map("tarefa_anexo")
}

/// O que foi EXCLUÍDO do módulo, por quem e por quê.
///
/// Existe por causa de um conflito real que a exclusão criou.
///
/// `TarefaLog` é declarado append-only ("log editável não é prova de nada"), mas
/// os logs são filhos da tarefa por FK com `onDelete: Cascade` — então apagar uma
/// competência apaga o histórico dela junto. Sem esta tabela, exclusão seria a
/// única operação do módulo que não deixa rastro, e justamente a mais grave.
///
/// A escolha foi manter a exclusão FÍSICA (foi o que o escritório pediu: "poder
/// excluir") e registrar o ato aqui fora, numa tabela que o cascade não alcança.
/// O registro não substitui o histórico apagado — guarda o que importa depois:
/// que existiu, o que era, quanta coisa foi junto, quem mandou e quando.
///
/// SEM FK para o registro excluído, de propósito. Uma FK obrigaria a linha a
/// morrer junto com o alvo, que é exatamente o que se quer evitar; e uma FK
/// opcional com SetNull perderia o id. `alvoId` é texto solto, e é assim que
/// deve ser.
///
/// APPEND-ONLY, como `TarefaLog`: a aplicação nunca faz UPDATE nem DELETE aqui.
model RegistroExclusao {
  id String @id @default(cuid())

  /// EMPRESA, APURACAO, PROCESSO_LEGALIZACAO
  tipo String

  /// Id do registro que deixou de existir. Texto solto, sem FK. Serve para
  /// cruzar com print de tela, e-mail e link antigo que alguém guardou.
  alvoId String @map("alvo_id")

  /// Como o registro era identificado na tela: razão social, "Março/2026 —
  /// Padaria Xpto", "Abertura de CNPJ — Empresa Xpto". É o que permite ler o
  /// registro sem precisar do id.
  descricao String

  /// Contexto que sobrevive ao alvo: CNPJ da empresa, competência, tipo do
  /// processo. Guardado como texto legível, não JSON, porque quem lê isto é
  /// gente conferindo o que aconteceu.
  detalhe String?

  /// O que foi levado no cascade, em número: "24 competências, 3 processos, 251
  /// etapas, 812 registros de histórico, 17 anexos". É a única resposta possível
  /// para "o que eu perdi quando cliquei ali".
  arrastado String?

  /// Motivo escrito por quem excluiu. Obrigatório na rota.
  motivo String

  /// Congelados, como em TarefaLog: funcionário sai da empresa, registro fica.
  excluidoPorId   String @map("excluido_por_id")
  excluidoPorNome String @map("excluido_por_nome")
  excluidoPorPapel String? @map("excluido_por_papel")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([tipo, createdAt])
  @@index([alvoId])
  @@index([excluidoPorId])
  @@index([createdAt])
  @@map("registro_exclusao")
}

/// Formulário público de abertura de CNPJ, como o cliente enviou.
///
/// Substitui o Google Forms da legalização. A rota que grava aqui é PÚBLICA, sem
/// login: o Forms exigia conta Google para anexar arquivo, e cliente sem Gmail
/// não conseguia mandar documento nenhum.
///
/// POR QUE `dados` É JSON E NÃO TRINTA COLUNAS.
///
/// O conteúdo é uma árvore de tamanho variável: N sócios, cada um com endereço,
/// estado civil, regime de bens e participação em outra empresa. Normalizar isso
/// daria quatro tabelas para guardar algo que ninguém consulta por campo — o
/// escritório abre um formulário e lê tudo. E o formulário é um DOCUMENTO
/// RECEBIDO: o que valia no dia do envio tem de continuar legível mesmo depois
/// de a tela mudar de perguntas, o que uma tabela normalizada quebraria na
/// primeira alteração de campo. Por isso o JSON guarda o envio inteiro, e ao lado
/// dele ficam só as colunas que a LISTA precisa para buscar e ordenar.
///
/// APPEND-ONLY na prática: não existe rota de UPDATE nem de DELETE para este
/// model. Formulário recebido é declaração do cliente, e declaração que o
/// escritório pode reescrever não prova nada. Correção vem de um envio novo, que
/// gera protocolo novo.
model FormularioAbertura {
  id String @id @default(cuid())

  /// Protocolo legível, o que o cliente lê no telefone: "CZ-7H2KQ4".
  /// Sem 0/O e sem 1/I/L, que são o que faz a pessoa ditar errado.
  protocolo String @unique

  /// Segredo da URL de consulta pública (`/formulario/recibo/<token>`).
  ///
  /// Separado do protocolo de propósito: o protocolo é curto para ser ditado, e
  /// curto o bastante para ser adivinhado por tentativa. Quem tem o token vê o
  /// formulário; então ele é longo e aleatório, e o protocolo não abre nada.
  token String @unique

  /// Snapshot do envio inteiro. Formato em `src/lib/formulario-abertura.ts`.
  dados Json

  /// ---------------------------------------------------------------------------
  /// Colunas desnormalizadas, só para a LISTA do admin buscar e ordenar.
  ///
  /// Duplicam informação que já está em `dados`. É deliberado: filtrar por campo
  /// dentro de JSON no Postgres não usa índice comum, e a lista precisa de busca
  /// por nome, CPF e CNPJ. A fonte da verdade continua sendo `dados`.
  /// ---------------------------------------------------------------------------

  /// 1ª opção de razão social. A empresa ainda não tem nome definitivo.
  razaoSocialPretendida String @map("razao_social_pretendida")
  nomeFantasia          String @map("nome_fantasia")

  /// Sócio 1, que é quem o comercial procura.
  socioPrincipalNome     String @map("socio_principal_nome")
  socioPrincipalCpf      String @map("socio_principal_cpf")
  socioPrincipalEmail    String @map("socio_principal_email")
  socioPrincipalTelefone String @map("socio_principal_telefone")

  quantidadeSocios     Int @map("quantidade_socios")
  capitalTotalCentavos Int @map("capital_total_centavos")

  /// RECEBIDO, EM_ANALISE, APROVADO, DEVOLVIDO
  ///
  /// Único campo que o escritório altera. Não contradiz o append-only do envio:
  /// é o andamento DA ANÁLISE, não o conteúdo declarado pelo cliente.
  situacao String @default("RECEBIDO")

  /// Anotação interna do escritório. Nunca aparece para o cliente.
  observacaoInterna String? @map("observacao_interna")

  /// De onde veio o envio. Serve para achar abuso na rota pública, que não tem
  /// login e aceita arquivo.
  ipOrigem      String? @map("ip_origem")
  navegadorInfo String? @map("navegador_info")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  documentos FormularioAberturaDocumento[]

  @@index([createdAt])
  @@index([situacao, createdAt])
  @@index([socioPrincipalCpf])
  @@index([socioPrincipalNome])
  @@map("formulario_abertura")
}

/// Documento anexado pelo cliente no formulário de abertura.
///
/// NUNCA É EXCLUÍDO. Não existe rota de DELETE para este model, e a relação com
/// o formulário é `onDelete: Restrict` de propósito: enquanto houver documento, o
/// banco RECUSA apagar o formulário. É o oposto de `TarefaAnexo`, que é
/// `onDelete: Cascade` e tem rota de remoção — lá o anexo é material de trabalho
/// interno, aqui é documento de identidade e comprovante de residência que o
/// cliente entregou uma vez, e que sustenta um contrato social.
///
/// `Restrict` em vez de confiar só na aplicação porque a garantia tem de
/// sobreviver a um `prisma studio` aberto às onze da noite.
///
/// POR QUE TABELA PRÓPRIA E NÃO `TarefaAnexo`: aquele model exige `apuracaoId` ou
/// `processoId` (CHECK no banco) e grava `enviadoPorId` de um usuário logado. Aqui
/// não existe tarefa ainda — o formulário chega ANTES de o processo ser criado — e
/// não existe usuário nenhum, porque a rota é pública.
model FormularioAberturaDocumento {
  id String @id @default(cuid())

  formularioId String @map("formulario_id")

  /// Chave do slot no formulário: `socio.0.identidade`, `socio.1.residencia`,
  /// `empresa.iptu`. É o que amarra o arquivo à PESSOA certa.
  slot String

  /// Nome de quem entregou, congelado como texto.
  ///
  /// O JSON de `dados` também tem o nome, mas ler o dono a partir do índice do
  /// slot exigiria abrir o JSON a cada linha da lista — e se um dia a ordem dos
  /// sócios no JSON mudar, o arquivo trocaria de dono em silêncio. Que é
  /// exactamente o defeito do Google Forms que esta tela existe para matar.
  dono String

  /// Rótulo do slot como o cliente viu: "RG ou CNH", "Comprovante de residência".
  rotulo String

  /// Nome que o arquivo tinha na máquina de quem enviou. É o que a tela mostra.
  nomeOriginal String @map("nome_original")

  /// Nome no disco: timestamp + aleatório + nome higienizado, com o dono no
  /// prefixo. Nunca o original, senão dois "rg.pdf" se sobrescreveriam.
  arquivo String @unique

  tipoMime     String @map("tipo_mime")
  tamanhoBytes Int    @map("tamanho_bytes")

  createdAt DateTime @default(now()) @map("created_at")

  formulario FormularioAbertura @relation(fields: [formularioId], references: [id], onDelete: Restrict)

  @@index([formularioId, slot])
  @@map("formulario_abertura_documento")
}
