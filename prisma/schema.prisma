generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(uuid())
  name                String
  email               String               @unique @db.Citext
  passwordHash        String               @map("password_hash")
  country             String?              @db.VarChar(2)
  role                String               @default("USER")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  blingAccounts       BlingAccount[]
  blingOauthStates    BlingOauthState[]
  categorias          Categoria[]
  contasPagar         ContaPagar[]
  contasReceber       ContaReceber[]
  formasPagamento     FormaPagamento[]
  meliAccounts        MeliAccount[]
  meliOauthStates     MeliOauthState[]
  meliVendas          MeliVenda[]
  meliFullStock       MeliFullStock[]
  shopeeAccounts      ShopeeAccount[]
  shopeeOauthStates   ShopeeOauthState[]
  shopeeVendas        ShopeeVenda[]
  tiktokAccounts      TiktokAccount[]
  tiktokVendas        TiktokVenda[]
  skus                SKU[]
  skuCustoHistorico   SKUCustoHistorico[]
  notifications       SyncNotification[]
  settings            UserSettings?
  aliquotasImposto    AliquotaImposto[]
  documents           Document[]
  documentFolders     DocumentFolder[]
  documentLogs        DocumentLog[]
  flexShippingConfigs FlexShippingConfig[]

  // --- Módulo de tarefas contábeis -----------------------------------------
  // Relações inversas apenas: não criam coluna nem alteram a tabela `usuario`.
  empresas             Empresa[]
  empresasResponsavel  Empresa[]             @relation("EmpresaResponsavel")
  apuracoesResponsavel TarefaApuracao[]      @relation("ApuracaoResponsavel")
  processosResponsavel ProcessoLegalizacao[] @relation("ProcessoResponsavel")
  tarefaLogs           TarefaLog[]           @relation("TarefaLogAutor")

  @@index([createdAt])
  @@map("usuario")
}

model MeliAccount {
  id                          String      @id @default(cuid())
  userId                      String
  ml_user_id                  BigInt
  nickname                    String?
  access_token                String
  refresh_token               String
  expires_at                  DateTime
  refresh_token_invalid_until DateTime?
  created_at                  DateTime    @default(now())
  updated_at                  DateTime    @updatedAt
  user                        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  meliVendas                  MeliVenda[]
  fullStock                   MeliFullStock[]

  @@unique([userId, ml_user_id], name: "userId_ml_user_id")
  @@map("meli_account")
}

model MeliOauthState {
  id         String   @id @default(cuid())
  state      String   @unique
  expires_at DateTime
  created_at DateTime @default(now())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expires_at])
  @@map("meli_oauth_state")
}

model ShopeeAccount {
  id                          String        @id @default(cuid())
  userId                      String        @map("user_id")
  shop_id                     String
  shop_name                   String?       @map("shop_name")
  merchant_id                 String?
  access_token                String
  refresh_token               String
  expires_at                  DateTime
  refresh_token_invalid_until DateTime?
  created_at                  DateTime      @default(now())
  updated_at                  DateTime      @updatedAt
  user                        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  shopeeVendas                ShopeeVenda[]

  @@unique([userId, shop_id], name: "userId_shop_id")
  @@map("shopee_account")
}

model ShopeeOauthState {
  id         String   @id @default(cuid())
  state      String   @unique
  userId     String   @map("user_id")
  expires_at DateTime
  created_at DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expires_at])
  @@map("shopee_oauth_state")
}

/// Loja do TikTok Shop conectada por um usuário.
///
/// Segue a forma de `ShopeeAccount`, com duas colunas que não existem em nenhuma
/// das outras plataformas:
///
/// - `shop_cipher`: o TikTok exige esse identificador em TODA chamada com escopo
///   de loja, e ele entra no cálculo da assinatura HMAC. Sem ele guardado não se
///   busca um pedido. Vem de `/authorization/202309/shops`, não do OAuth.
/// - `refresh_expires_at`: a API informa o prazo do refresh token (observado em
///   ~100 anos). Guardamos o que ela diz em vez de assumir que é eterno.
///
/// Não existe `TiktokOauthState` de propósito: as tabelas `meli_oauth_state` e
/// `shopee_oauth_state` existem no schema e estão órfãs — nenhuma rota de OAuth
/// as usa, porque o `state` viaja em cookie HttpOnly. Criar a terceira só
/// acrescentaria tabela morta.
model TiktokAccount {
  id                          String        @id @default(cuid())
  userId                      String        @map("user_id")
  shop_id                     String
  shop_cipher                 String?       @map("shop_cipher")
  shop_name                   String?       @map("shop_name")
  seller_name                 String?       @map("seller_name")
  region                      String?
  access_token                String
  refresh_token               String
  expires_at                  DateTime
  refresh_expires_at          DateTime?     @map("refresh_expires_at")
  refresh_token_invalid_until DateTime?
  created_at                  DateTime      @default(now())
  updated_at                  DateTime      @updatedAt
  user                        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  tiktokVendas                TiktokVenda[]

  @@unique([userId, shop_id], name: "userId_shop_id")
  @@map("tiktok_account")
}

/// Venda do TikTok Shop.
///
/// Espelha `ShopeeVenda` nas colunas comuns, para a agregação de `/api/vendas` e
/// o `UNION ALL` de `/api/v2/geral/vendas` alinharem sem caso especial.
///
/// `isMargemReal` tem peso maior aqui do que nas outras duas: no TikTok o
/// financeiro só fica DEFINITIVO quando o pedido liquida (entrega + ~7 dias no
/// Brasil). O sync grava primeiro o ESTIMADO, para a venda aparecer na hora, e um
/// segundo passo troca pelo valor do extrato e marca `true`. Enquanto for `false`,
/// a margem é projeção.
model TiktokVenda {
  id                 String        @id @default(cuid())
  orderId            String        @unique @map("order_id")
  userId             String        @map("user_id")
  tiktokAccountId    String        @map("tiktok_account_id")
  dataVenda          DateTime      @map("data_venda")
  status             String
  conta              String
  valorTotal         Decimal       @map("valor_total") @db.Decimal(10, 2)
  quantidade         Int
  unitario           Decimal       @map("valor_unitario") @db.Decimal(10, 2)
  taxaPlataforma     Decimal?      @map("taxa_plataforma") @db.Decimal(10, 2)
  frete              Decimal       @map("valor_frete") @db.Decimal(10, 2)
  freteAjuste        Decimal?      @map("frete_ajuste") @db.Decimal(12, 2)
  cmv                Decimal?      @map("cmv") @db.Decimal(10, 2)
  margemContribuicao Decimal?      @map("margem_contribuicao") @db.Decimal(10, 2)
  isMargemReal       Boolean       @default(false) @map("is_margem_real")
  titulo             String
  sku                String?
  comprador          String
  itemId             String?       @map("item_id") @db.VarChar(64)
  logisticType       String?       @map("logistic_type")
  envioMode          String?       @map("envio_mode")
  shippingStatus     String?       @map("shipping_status")
  shippingId         String?       @map("shipping_id")

  /// Prazo para despachar o pedido. Contraparte do campo de mesmo nome em
  /// `MeliVenda` e `ShopeeVenda` — ver o docblock completo em `MeliVenda`.
  ///
  /// No TikTok vem de `rts_time`/`ship_by_date` do pedido, como epoch em
  /// SEGUNDOS. Mesmo cuidado da Shopee: `0` é "não se aplica" e tem de virar
  /// NULL, senão a tela anuncia atraso desde 1970.
  prazoDespacho      DateTime?     @map("prazo_despacho") @db.Timestamptz(3)

  /// Origem do prazo e marcador de "já olhei". Ver `MeliVenda.prazoDespachoOrigem`.
  /// Valores: `tt_rts_time`, `tt_ship_by_date`, `tt_collection_due` e o marcador
  /// versionado `PRAZO_ORIGEM_AUSENTE` (`ausente:N`), o MESMO de ML e Shopee —
  /// é ele que o backfill usa para saber se a linha já passou pelas regras atuais.
  prazoDespachoOrigem String?      @map("prazo_despacho_origem") @db.VarChar(32)

  latitude           Decimal?      @db.Decimal(10, 7)
  longitude          Decimal?      @db.Decimal(10, 7)
  shipmentDetails    Json?         @map("shipment_details")
  paymentDetails     Json?         @map("payment_details")
  plataforma         String        @default("TikTok Shop")
  canal              String        @default("TT")
  tags               Json?
  internalTags       Json?         @map("internal_tags")
  rawData            Json?         @map("raw_data")
  sincronizadoEm     DateTime      @default(now()) @map("sincronizado_em")
  atualizadoEm       DateTime      @updatedAt @map("atualizado_em")
  tiktokAccount      TiktokAccount @relation(fields: [tiktokAccountId], references: [id], onDelete: Cascade)
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tiktokAccountId])
  @@index([dataVenda])
  @@index([orderId])
  @@index([userId, dataVenda(sort: Desc)])
  @@index([sku])
  @@index([status])
  @@index([userId, prazoDespacho])
  /// Fila do passo de liquidação: só os pedidos que ainda não têm financeiro real.
  @@index([tiktokAccountId, isMargemReal])
  @@map("tiktok_venda")
}

model BlingAccount {
  id                          String    @id @default(cuid())
  userId                      String    @map("user_id")
  bling_user_id               String?   @map("bling_user_id")
  account_name                String?   @map("account_name")
  access_token                String
  refresh_token               String
  expires_at                  DateTime
  refresh_token_invalid_until DateTime?
  created_at                  DateTime  @default(now())
  updated_at                  DateTime  @updatedAt
  user                        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, bling_user_id], name: "userId_bling_user_id")
  @@map("bling_account")
}

model BlingOauthState {
  id         String   @id @default(cuid())
  state      String   @unique
  userId     String   @map("user_id")
  expires_at DateTime
  created_at DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expires_at])
  @@map("bling_oauth_state")
}

model MeliVenda {
  id                 String      @id @default(cuid())
  orderId            String      @unique @map("order_id")
  userId             String      @map("user_id")
  meliAccountId      String      @map("meli_account_id")
  dataVenda          DateTime    @map("data_venda")
  status             String
  conta              String
  valorTotal         Decimal     @map("valor_total") @db.Decimal(10, 2)
  quantidade         Int
  unitario           Decimal     @map("valor_unitario") @db.Decimal(10, 2)
  taxaPlataforma     Decimal?    @map("taxa_plataforma") @db.Decimal(10, 2)
  frete              Decimal     @map("valor_frete") @db.Decimal(10, 2)
  cmv                Decimal?    @map("cmv") @db.Decimal(10, 2)
  margemContribuicao Decimal?    @map("margem_contribuicao") @db.Decimal(10, 2)
  isMargemReal       Boolean     @default(false) @map("is_margem_real")
  titulo             String
  sku                String?

  /// MLB do anúncio (order_items[0].item.id).
  ///
  /// Coluna ADITIVA (migrations/20260903120000), nullable. O dado sempre
  /// chegou dentro de `rawData` e era descartado — só título e SKU eram
  /// persistidos. Sem ele não há como agrupar vendas por ANÚNCIO, que é o eixo
  /// da tela de Anúncios Mais Vendidos e Mortos: SKU não serve, porque um SKU
  /// vive em vários anúncios e um anúncio com variações tem vários SKUs.
  ///
  /// Linha antiga fica NULL até o backfill rodar (`src/lib/anuncios-backfill.ts`),
  /// e as consultas caem no JSON como reserva enquanto isso, para nenhuma venda
  /// ficar invisível no meio do preenchimento.
  itemId             String?     @map("item_id") @db.VarChar(32)

  /// Variação do anúncio (order_items[0].item.variation_id), como texto.
  ///
  /// Coluna ADITIVA (migrations/20260905100000), nullable. Existe para a
  /// cobertura de estoque do módulo Estoque Full: no Mercado Livre um anúncio
  /// com variações tem estoque SEPARADO por variação, então comparar o estoque
  /// da variação P com as vendas do anúncio inteiro multiplicaria a venda diária
  /// e a tela diria "repor" em tudo ao mesmo tempo.
  ///
  /// `"-"` significa "olhei o pedido e não havia variação" (anúncio simples), e
  /// é diferente de NULL, que significa "ainda não preenchido". Sem essa
  /// distinção o backfill releria o mesmo JSON para sempre e nunca convergiria.
  /// Ver `src/lib/estoque-full-backfill.ts`.
  variationId        String?     @map("variation_id") @db.VarChar(32)
  comprador          String
  logisticType       String?     @map("logistic_type")
  envioMode          String?     @map("envio_mode")
  shippingStatus     String?     @map("shipping_status")
  shippingId         String?     @map("shipping_id")

  /// Prazo para o vendedor DESPACHAR o pedido (não é o prazo de entrega).
  ///
  /// Coluna ADITIVA (migrations/20260909120000), nullable. É o eixo da tela de
  /// Expedição: a ordem da fila é o prazo, não a data da venda — uma venda de
  /// ontem com prazo hoje é mais urgente que uma de hoje com prazo na semana que
  /// vem, e ordenar por `dataVenda` inverte exatamente as duas.
  ///
  /// Vem do `/shipments/{id}` que o sync de vendas já chama, em
  /// `shipping_option.estimated_handling_limit.date`, com `sla.expected_date`
  /// como reserva. O dado sempre chegou e era descartado; para as vendas antigas
  /// ele está em `rawData.shipment` e é recuperado sem API por
  /// `src/lib/prazo-despacho-backfill.ts`.
  ///
  /// `Timestamptz` e não `Timestamp` como o resto da tabela: a urgência é uma
  /// comparação de data civil em São Paulo, e com `Timestamp` o
  /// `AT TIME ZONE 'America/Sao_Paulo'` desloca tudo em 3h, jogando todo prazo
  /// entre 21h e meia-noite para o dia seguinte.
  prazoDespacho      DateTime?   @map("prazo_despacho") @db.Timestamptz(3)

  /// De onde o prazo saiu — e o marcador de "já olhei esta linha".
  ///
  /// NULL significa "ainda não processada". `'ausente'` significa "processada e o
  /// JSON não tinha prazo". Sem essa distinção, toda venda sem prazo (FULL,
  /// retirada em agência, cancelada antes de gerar envio) voltaria à fila do
  /// backfill em cada rodada e ele nunca chegaria a zero. Mesmo papel do
  /// marcador `"-"` de `variationId`, que não cabe numa coluna temporal.
  ///
  /// Valores: `ml_handling_limit`, `ml_sla_expected`, `ml_shipping_limit`,
  /// `ausente`. Ver `src/lib/prazo-despacho.ts`.
  prazoDespachoOrigem String?    @map("prazo_despacho_origem") @db.VarChar(32)

  exposicao          String?
  tipoAnuncio        String?     @map("tipo_anuncio")
  ads                String?
  plataforma         String      @default("Mercado Livre")
  canal              String      @default("ML")
  tags               Json?
  internalTags       Json?       @map("internal_tags")
  rawData            Json?       @map("raw_data")
  sincronizadoEm     DateTime    @default(now()) @map("sincronizado_em")
  atualizadoEm       DateTime    @updatedAt @map("atualizado_em")
  latitude           Decimal?    @db.Decimal(10, 7)
  longitude          Decimal?    @db.Decimal(10, 7)
  freteAdjustment    Decimal?    @map("frete_adjustment") @db.Decimal(10, 2)
  freteAjuste        Decimal?    @map("frete_ajuste") @db.Decimal(12, 2)
  freteBaseCost      Decimal?    @map("frete_base_cost") @db.Decimal(10, 2)
  freteCalculation   Json?       @map("frete_calculation")
  freteFinalCost     Decimal?    @map("frete_final_cost") @db.Decimal(10, 2)
  freteListCost      Decimal?    @map("frete_list_cost") @db.Decimal(10, 2)
  meliAccount        MeliAccount @relation(fields: [meliAccountId], references: [id], onDelete: Cascade)
  user               User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([meliAccountId])
  @@index([dataVenda])
  @@index([orderId])
  @@index([userId, dataVenda(sort: Desc)]) // Índice composto para queries principais
  @@index([sku]) // Índice para busca por SKU
  @@index([status]) // Índice para filtros de status
  @@index([userId, itemId, dataVenda(sort: Desc)]) // Ranking por anúncio
  @@index([userId, itemId, variationId]) // Vendas 30d por variação (Estoque Full)
  @@index([userId, prazoDespacho]) // Fila da tela de Expedição, ordenada por prazo
  @@map("meli_venda")
}

// ---------------------------------------------------------------------
// Estoque Full (Mercado Envíos Full / fulfillment)
//
// Snapshot do estoque que está nos centros de distribuição do Mercado Livre,
// vindo da API oficial. Duas tabelas: o estado atual por inventário e uma linha
// por dia para calcular o "estoque médio" dos últimos 30 dias.
//
// Estoque NÃO é derivável de venda: unidade pode entrar por reposição, sair por
// devolução, ficar retida por avaria. Só a API do ML sabe o número, e por isso
// existe snapshot em vez de cálculo.
//
// DIFERENÇA DELIBERADA EM RELAÇÃO AO NEXUS V2: lá a chave primária é o próprio
// `inventory_id`, porque o sistema tem um único usuário. Aqui a chave é sintética
// e a unicidade real é `(meliAccountId, inventoryId)` — o CONTAZOOM é
// multiusuário e a mesma conta do Mercado Livre pode estar ligada a usuários
// diferentes, então `inventory_id` sozinho faria o sync de um sobrescrever a
// linha do outro.
// ---------------------------------------------------------------------

model MeliFullStock {
  id            String @id @default(cuid())
  userId        String @map("user_id")
  meliAccountId String @map("meli_account_id")

  /// Chave do estoque no ML. Um anúncio com variações tem um por variação.
  inventoryId String  @map("inventory_id")
  itemId      String? @map("item_id") @db.VarChar(32)
  variationId String? @map("variation_id") @db.VarChar(32)
  /// Modelo novo de estoque do ML. É por aqui que se busca o SKU quando o
  /// `/items` não traz (ver `estoque-full-sync.ts`).
  userProductId String? @map("user_product_id")

  sku           String?
  titulo        String?
  thumbnail     String?
  logisticType  String? @map("logistic_type")

  total             Int @default(0)
  /// Unidades prontas para venda. É o número que a tela destaca.
  availableQuantity Int @default(0) @map("available_quantity")
  /// Não aptas, JÁ LÍQUIDO das unidades em transferência — o ML devolve as duas
  /// coisas somadas em `not_available_quantity`, mas o painel dele separa.
  notAvailableQuantity Int @default(0) @map("not_available_quantity")
  /// "A caminho": unidades em transferência para o centro de distribuição.
  transferQuantity     Int @default(0) @map("transfer_quantity")
  /// O array cru de `not_available_detail`. Guardado inteiro porque os outros
  /// motivos (avaria, extravio, retirada) não têm coluna própria e um dia vão
  /// precisar de tela.
  notAvailableDetail Json? @map("not_available_detail")

  sincronizadoEm DateTime @default(now()) @map("sincronizado_em")

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  meliAccount MeliAccount @relation(fields: [meliAccountId], references: [id], onDelete: Cascade)

  @@unique([meliAccountId, inventoryId])
  @@index([userId])
  @@index([userId, itemId, variationId])
  @@index([sku])
  @@map("meli_full_stock")
}

model MeliFullStockHistory {
  id                String   @id @default(cuid())
  userId            String   @map("user_id")
  inventoryId       String   @map("inventory_id")
  dia               DateTime @db.Date
  availableQuantity Int      @map("available_quantity")
  total             Int      @default(0)
  createdAt         DateTime @default(now()) @map("created_at")

  // Sem relação com MeliFullStock de propósito: o sync apaga o inventário que
  // saiu do Full, e uma cascata levaria a série histórica junto. A média de 30
  // dias precisa sobreviver a um produto sair e voltar.
  @@unique([userId, inventoryId, dia])
  @@index([inventoryId])
  @@map("meli_full_stock_history")
}

model ShopeeVenda {
  id                 String        @id @default(cuid())
  orderId            String        @unique @map("order_id")
  userId             String        @map("user_id")
  shopeeAccountId    String        @map("shopee_account_id")
  dataVenda          DateTime      @map("data_venda")
  status             String
  conta              String
  valorTotal         Decimal       @map("valor_total") @db.Decimal(10, 2)
  quantidade         Int
  unitario           Decimal       @map("valor_unitario") @db.Decimal(10, 2)
  taxaPlataforma     Decimal?      @map("taxa_plataforma") @db.Decimal(10, 2)
  frete              Decimal       @map("valor_frete") @db.Decimal(10, 2)
  freteAjuste        Decimal?      @map("frete_ajuste") @db.Decimal(12, 2)
  cmv                Decimal?      @map("cmv") @db.Decimal(10, 2)
  margemContribuicao Decimal?      @map("margem_contribuicao") @db.Decimal(10, 2)
  isMargemReal       Boolean       @default(false) @map("is_margem_real")
  titulo             String
  sku                String?
  comprador          String
  logisticType       String?       @map("logistic_type")
  envioMode          String?       @map("envio_mode")
  shippingStatus     String?       @map("shipping_status")
  shippingId         String?       @map("shipping_id")

  /// Prazo para despachar o pedido. Contraparte do campo de mesmo nome em
  /// `MeliVenda` — ver o docblock completo lá.
  ///
  /// Na Shopee vem de `ship_by_date` do `get_order_detail` (campo padrão da
  /// resposta, não precisa ser pedido em `response_optional_fields`), como epoch
  /// em SEGUNDOS. O valor `0` é o "não se aplica" da Shopee e tem de virar NULL:
  /// convertido literalmente, `to_timestamp(0)` dá 1970 e a tela anuncia
  /// "atrasado há 20 mil dias".
  prazoDespacho      DateTime?     @map("prazo_despacho") @db.Timestamptz(3)

  /// Origem do prazo e marcador de "já olhei". Ver `MeliVenda.prazoDespachoOrigem`.
  /// Valores: `sp_ship_by_date`, `sp_package_ship_by_date`, `ausente`.
  prazoDespachoOrigem String?      @map("prazo_despacho_origem") @db.VarChar(32)

  paymentMethod      String?       @map("payment_method")
  paymentStatus      String?       @map("payment_status")
  latitude           Decimal?      @db.Decimal(10, 7)
  longitude          Decimal?      @db.Decimal(10, 7)
  freteBaseCost      Decimal?      @map("frete_base_cost") @db.Decimal(10, 2)
  freteListCost      Decimal?      @map("frete_list_cost") @db.Decimal(10, 2)
  freteFinalCost     Decimal?      @map("frete_final_cost") @db.Decimal(10, 2)
  freteAdjustment    Decimal?      @map("frete_adjustment") @db.Decimal(10, 2)
  freteCalculation   Json?         @map("frete_calculation")
  shipmentDetails    Json?         @map("shipment_details")
  paymentDetails     Json?         @map("payment_details")
  plataforma         String        @default("Shopee")
  canal              String        @default("SP")
  tags               Json?
  internalTags       Json?         @map("internal_tags")
  rawData            Json?         @map("raw_data")
  sincronizadoEm     DateTime      @default(now()) @map("sincronizado_em")
  atualizadoEm       DateTime      @updatedAt @map("atualizado_em")
  shopeeAccount      ShopeeAccount @relation(fields: [shopeeAccountId], references: [id], onDelete: Cascade)
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([shopeeAccountId])
  @@index([dataVenda])
  @@index([orderId])
  @@index([userId, dataVenda(sort: Desc)]) // Índice composto para queries principais
  @@index([sku]) // Índice para busca por SKU
  @@index([status]) // Índice para filtros de status
  @@index([userId, prazoDespacho]) // Fila da tela de Expedição, ordenada por prazo
  @@map("shopee_venda")
}

